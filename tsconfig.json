{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ]
  },
  "include": [
    "packages/**/*.tsx",
    "catalog/**/*.tsx",
    "catalog/runtime.ts"
  ],
  "exclude": [
    "packages/*/dist",
    "node_modules"
  ]
}
